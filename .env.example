# Icons environment configuration
#
# Copy this file to .env.local for local development.
# Never commit real credentials or secrets.

# Application
VITE_APP_ENV=development

# Photopea
# Keep empty unless the selected Photopea integration explicitly requires a credential.
# Do not invent or commit API keys.
VITE_PHOTOPEA_ENABLED=true
VITE_PHOTOPEA_API_KEY=
