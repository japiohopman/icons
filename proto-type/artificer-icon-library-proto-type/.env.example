# Gemini
# Required for Gemini AI API calls.
# Configure the real secret in your local/hosting environment; never commit it.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application URL
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Photopea
# Keep disabled until the Photopea integration explicitly requires configuration.
# Do not commit real credentials or API keys.
VITE_PHOTOPEA_ENABLED=true
VITE_PHOTOPEA_API_KEY=""
